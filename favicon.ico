"use client";

import {
  Area,
  AreaChart,
  CartesianGrid,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import { EquityPoint } from "@/lib/aggregations";
import { formatCurrencyCompact, formatCurrency, RechartsTooltipProps } from "@/lib/format";
import { format as formatDate } from "date-fns";
import { useViewStore } from "@/store/view-store";

function EquityTooltip({ active, payload }: RechartsTooltipProps<EquityPoint>) {
  const { hidePnl } = useViewStore();
  if (!active || !payload?.length) return null;
  const p: EquityPoint = payload[0].payload;
  return (
    <div className="rounded-lg border border-border bg-card card-shadow-hover px-3 py-2 text-xs">
      <div className="text-fg-subtle mb-1">{formatDate(new Date(p.date), "MMM d, yyyy")}</div>
      <div className="font-medium text-fg tabular-nums">
        Equity: {hidePnl ? "•••" : formatCurrency(p.equity, { sign: true })}
      </div>
      {p.drawdown < -0.01 && (
        <div className="text-loss tabular-nums">
          Drawdown: {hidePnl ? "•••" : formatCurrency(p.drawdown)}
        </div>
      )}
    </div>
  );
}

export function EquityCurveChart({ data }: { data: EquityPoint[] }) {
  const lossColor = "var(--color-loss)";
  const isNegative = data.length > 0 && data[data.length - 1].equity < 0;

  return (
    <div className="h-72 w-full">
      <ResponsiveContainer width="100%" height="100%">
        <AreaChart data={data} margin={{ top: 8, right: 8, left: 0, bottom: 0 }}>
          <defs>
            <linearGradient id="equityFill" x1="0" y1="0" x2="0" y2="1">
              <stop
                offset="0%"
                stopColor={isNegative ? lossColor : "var(--color-accent)"}
                stopOpacity={0.25}
              />
              <stop
                offset="100%"
                stopColor={isNegative ? lossColor : "var(--color-accent)"}
                stopOpacity={0}
              />
            </linearGradient>
          </defs>
          <CartesianGrid stroke="var(--color-border)" vertical={false} />
          <XAxis
            dataKey="date"
            tickFormatter={(d) => formatDate(new Date(d), "MMM d")}
            tick={{ fontSize: 11, fill: "var(--color-fg-subtle)" }}
            axisLine={{ stroke: "var(--color-border)" }}
            tickLine={false}
            minTickGap={40}
          />
          <YAxis
            tickFormatter={(v) => formatCurrencyCompact(v)}
            tick={{ fontSize: 11, fill: "var(--color-fg-subtle)" }}
            axisLine={false}
            tickLine={false}
            width={56}
          />
          <Tooltip
            content={<EquityTooltip />}
            cursor={{ stroke: "var(--color-accent)", strokeWidth: 1, strokeDasharray: "4 4" }}
          />
          <Area
            type="monotone"
            dataKey="equity"
            stroke={isNegative ? lossColor : "var(--color-accent-strong)"}
            strokeWidth={2}
            fill="url(#equityFill)"
            isAnimationActive={true}
            animationDuration={500}
          />
        </AreaChart>
      </ResponsiveContainer>
    </div>
  );
}

export function DrawdownStrip({ data }: { data: EquityPoint[] }) {
  return (
    <div className="h-16 w-full -mt-2">
      <ResponsiveContainer width="100%" height="100%">
        <AreaChart data={data} margin={{ top: 0, right: 8, left: 0, bottom: 0 }}>
          <XAxis dataKey="date" hide />
          <YAxis hide domain={["dataMin", 0]} />
          <Area
            type="monotone"
            dataKey="drawdown"
            stroke="var(--color-loss)"
            strokeWidth={1}
            fill="var(--color-loss)"
            fillOpacity={0.18}
            isAnimationActive={true}
            animationDuration={500}
          />
        </AreaChart>
      </ResponsiveContainer>
      <div className="text-[10px] text-fg-subtle text-center -mt-1">Drawdown</div>
    </div>
  );
}
